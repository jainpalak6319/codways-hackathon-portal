# Dependencies
node_modules/

# Production Build output (if using compilation like TypeScript/Babel later)
/dist
/build

# Runtime logs and process managers data
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pids
*.pid
*.seed
*.pid.lock

# PM2 (Production Process Manager) files
